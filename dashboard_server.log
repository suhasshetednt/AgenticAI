  GENERATED SQL  (attempt 1  |  ADL-1700)
==============================================================

-- VDS: APU Health Monitor
-- Folder: Engine
-- Purpose: Monitor APU health for B737NG aircraft by extracting APU performance data from AMOS
-- Grain: One row per APU (rotable) per latest trend reference date
-- Source: amos_postgres.amos.rotables, amos_postgres.amos.rotables_trend, amos_postgres.amos.aircraft
-- Last Modified: ADL-1700

WITH apu_trend_ranked AS (
  SELECT
    rt.psn,
    rt.recno,
    rt.ref_date,
    rt.trend_type,
    rt."value",
    rt.event_perfno_i,
    ROW_NUMBER() OVER (PARTITION BY rt.psn ORDER BY rt.ref_date DESC) AS rn
  FROM amos_postgres.amos.rotables_trend rt
  WHERE UPPER(rt.trend_type) = UPPER('CT5')
)
SELECT
  r.partno,
  r.serialno,
  r.psn,
  r.ac_registr,
  DATE_ADD(DATE '1971-12-31', CAST(atr.ref_date AS BIGINT)) AS ref_date,
  atr.trend_type,
  COALESCE(atr.event_perfno_i, NULL) AS event_perfno_i,
  atr."value" AS ct5atp_value,
  a.ac_typ
FROM amos_postgres.amos.rotables r
INNER JOIN amos_postgres.amos.aircraft a
  ON UPPER(r.ac_registr) = UPPER(a.ac_registr)
LEFT JOIN apu_trend_ranked atr
  ON r.psn = atr.psn
  AND atr.rn = 1
WHERE UPPER(a.ac_typ) = UPPER('B737NG')
  AND r.ac_registr IS NOT NULL

